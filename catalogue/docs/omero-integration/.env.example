#########################################################################
# .env.example - OMERO + catalogue integration
#
# Sanitized template for a compose stack running this catalogue app
# alongside an existing OMERO deployment (see compose.example.yaml and
# nginx.conf.example in this folder, and README.md for the full
# walkthrough). Safe to commit/share as-is: every secret and every
# site-specific value below is CHANGE_ME, not a real value.
#
# To use: copy to .env in your actual compose project root, replace
# every CHANGE_ME, then confirm nothing was missed:
#
#   grep -n CHANGE_ME .env    # review what's left
#   grep -c CHANGE_ME .env    # must print 0 before deploying
#
# Everything NOT marked CHANGE_ME is a technical default (image
# versions, internal ports, relative paths) that's reasonable to keep
# as-is for most deployments - only change those if you have a specific
# reason to (e.g. pinning a different image version).
#
# This file covers BOTH the OMERO-side variables compose.example.yaml
# references and the catalogue-side ones - if you already have OMERO
# running with its own .env, only add the catalogue-side section below
# to it, and skip the OMERO-side variables here entirely.
#########################################################################

#########################################################################
# System
#########################################################################
# SELinux bind-mount option. Leave as-is on SELinux systems (Fedora,
# RHEL, CentOS); change to empty ("") on systems without SELinux.
VOLOPTS=,z

#########################################################################
# OMERO Postgres database (your existing OMERO deployment)
#########################################################################
OMEROPGUSER="omero"
OMEROPGDB="omero"
# CHANGE ME - real secret, used to authenticate to the OMERO Postgres DB.
OMEROPGPASSWORD=CHANGE_ME

#########################################################################
# OMERO server (your existing OMERO deployment)
#########################################################################
# CHANGE ME - real secret, OMERO's root/admin account password.
OMEROROOTPASSWORD=CHANGE_ME

# External OMERO data folder - wherever your actual slide/image data
# lives on the host. Site-specific; there is no sensible generic default.
OMEROFILESEXTERNALPATH=CHANGE_ME   # e.g. /OMERO or /mnt/slide-data

#########################################################################
# Nginx (the shared, domain-routing nginx - see nginx.conf.example)
#########################################################################
NGINXCONFFILE="./nginx/nginx.conf"
NGINXCERTIFICATEFOLDER="./certs/nginx"

#########################################################################
# Software versions - a good starting point, not mandatory pins.
#########################################################################
OMEROSERVER_IMAGEVERSION="5.6.18"
OMEROWEB_IMAGEVERSION="5.32"
POSTGRES_IMAGEVERSION="16.14"
NGINX_IMAGEVERSION="1.28"
MARIADB_IMAGEVERSION=11
# Independent from NGINX_IMAGEVERSION above - same image, different
# role (this one only serves the catalogue app's static frontend).
CATALOGUE_NGINX_IMAGEVERSION=1.28
ADMINER_IMAGEVERSION=latest

#########################################################################
# Domain / SSL
#########################################################################
# CHANGE ME - your OMERO domain (matches nginx.conf.example's
# omero.yourdomain.com placeholder).
FULLDOMAIN=CHANGE_ME   # e.g. omero.yourdomain.com

#########################################################################
# Catalogue app
#########################################################################
APP_ENV=production
APP_ROOT_PATH=
# Must be false while served over plain HTTP; flip to true only once
# the catalogue domain is actually behind HTTPS, or session cookies
# silently won't be sent (the browser drops secure-only cookies set
# over plain HTTP).
APP_COOKIE_SECURE=false
# CHANGE ME - real secret, signs session cookies and activation/reset
# tokens. Generate with: openssl rand -hex 64
APP_SESSION_SECRET=CHANGE_ME

# Direct/standalone access port for the catalogue app, independent of
# whatever domain-routing nginx sits in front of it (useful for
# sanity-checking catalogue_nginx directly without going through the
# shared nginx at all).
HTTP_PORT=8080
# Dev-only - adminer isn't started unless you run
# `docker compose --profile dev up -d`.
ADMINER_PORT=8081

# CHANGE ME - real secret.
MARIADB_ROOT_PASSWORD=CHANGE_ME
MARIADB_DATABASE=catalogue
MARIADB_USER=catalogue_app
# CHANGE ME - real secret.
MARIADB_PASSWORD=CHANGE_ME

# CHANGE ME - network paths to your actual virtual-microscopy share, per
# platform. No sensible generic default. Shown to catalogue users as a
# ready-to-copy path when mounting the share themselves.
SHARE_ROOT_WINDOWS=CHANGE_ME   # e.g. \\your-share\virtual-microscopy
SHARE_ROOT_MACOS=CHANGE_ME     # e.g. /Volumes/virtual-microscopy
SHARE_ROOT_LINUX=CHANGE_ME     # e.g. /mnt/virtual-microscopy

#########################################################################
# Outgoing mail (account activation, password reset)
#########################################################################
# CHANGE ME - your SMTP relay's hostname.
SMTP_HOST=CHANGE_ME   # e.g. smtp.gmail.com
SMTP_PORT=587
# CHANGE ME - SMTP auth username.
SMTP_USERNAME=CHANGE_ME
# CHANGE ME - real secret (app password / SMTP auth password).
SMTP_PASSWORD=CHANGE_ME
# CHANGE ME - the From: address on outgoing mail. Some providers
# (Gmail included) require this to match SMTP_USERNAME.
SMTP_FROM=CHANGE_ME

# CHANGE ME - public base URL used to build links in outgoing emails
# (e.g. account activation). Update again when moving from HTTP to
# HTTPS - a stale value here means broken links in real emails, and the
# session cookie itself won't be sent if this is out of sync with
# APP_COOKIE_SECURE above.
APP_BASE_URL=CHANGE_ME   # e.g. http://catalogue.yourdomain.com

# What to call your institution's external identity number (e.g.
# student/staff ID) wherever the frontend asks for or displays it - the
# underlying field is always called "guid" in the database/API
# regardless of this label. Not a secret, safe to leave as the default.
INSTITUTION_ID_LABEL=Institution ID
