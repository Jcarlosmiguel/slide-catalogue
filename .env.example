APP_ENV=development
APP_ROOT_PATH=
APP_COOKIE_SECURE=false
# CHANGE ME - a real secret, at least 32 random characters, e.g. the output
# of `openssl rand -hex 32`. The app refuses to start with this placeholder
# left in place, or with anything shorter than 32 characters - signing
# session cookies with a guessable/shared secret would let anyone forge a
# valid session, including system_admin, against this deployment.
APP_SESSION_SECRET=change-me-to-a-long-random-string

HTTP_PORT=8080
ADMINER_PORT=8081

# Change these passwords before deploying anywhere other than your own machine.
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=catalogue
MARIADB_USER=catalogue_app
MARIADB_PASSWORD=change-me

# Mount paths of your slide archive share on each OS, shown to users as a
# ready-to-copy path for mounting the share locally.
SHARE_ROOT_WINDOWS=\\share\virtual-microscopy
SHARE_ROOT_MACOS=/Volumes/virtual-microscopy
SHARE_ROOT_LINUX=/mnt/virtual-microscopy

# Outgoing mail (account activation, password reset).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notifications@example.com

# Per-purpose "From" display name, all relayed through the SMTP_*
# account above - until real dedicated mailboxes exist per purpose, this
# just varies the display name a recipient sees, e.g.
# "Catalogue Contact" <SMTP_FROM's real address>. Point it at a real
# address instead once one exists - no code change needed. MAIL_FROM_ACCESS
# isn't used by any code path yet - share-access.html is still a
# placeholder stub.
MAIL_FROM_REGISTRATION="Catalogue Registration <notifications@example.com>"
MAIL_FROM_CONTACT="Catalogue Contact <notifications@example.com>"
MAIL_FROM_ACCESS="Catalogue Access <notifications@example.com>"

# Where the public contact form (catalogue/documents/contact.html)
# actually delivers messages. Kept server-side only, never sent to the
# browser.
CONTACT_NOTIFICATION_EMAIL=contact@example.com

# Public base URL used to build links in outgoing emails.
APP_BASE_URL=http://localhost:8080

# What to call your institution's external identity number (e.g. student/staff
# ID) wherever the frontend asks for or displays it - the underlying field is
# always called "guid" in the database/API regardless of this label.
INSTITUTION_ID_LABEL=Institution ID
